rules_version = '2';

// ===============================================================
// Babala Firestore rules
// ===============================================================
//
// Only officers save alerts. An officer is someone signed in with Google
// whose user ID has a document in `officers`. The project owner adds those
// documents in the Firebase console, which these rules don't apply to; the
// app can't write them. Everything not allowed below is denied.
//
// Residents (anonymous sign-in) get read access to alerts in the resident
// view step, not yet.
//
// ===============================================================
// Data model
// ===============================================================
//
// Collection: officers
// Document ID: the officer's Firebase Auth user ID
// Fields: any (e.g. name: string), set by hand in the Firebase console.
//   Only the document's existence matters.
//
// Collection: alerts
// Document ID: "{household}__{areaKey}", e.g. "general__purok-ilaya".
//   One current alert per household type and area; a new approval replaces it.
//   Written by src/alerts/record.ts and src/alerts/store.ts. Keep the limits
//   here the same as LIMITS in record.ts.
// Fields (all required unless marked optional):
//   - household: string, one of general, seniors, families, fishers
//   - area: string, 1 to 80 characters, e.g. "Purok Ilaya"
//   - areaKey: string, 1 to 80 characters of a-z, 0-9 and single dashes
//   - signal: int, 1 to 5, the area's signal in the fact sheet
//   - text: string, 1 to 1000 characters, the alert as the checker passed it
//   - factSheet: map, the confirmed fact sheet:
//       stormName: string (up to 100)
//       signals: list of {area: string, signal: int} (1 to 30)
//       landfallTime: string "HH:MM", 24-hour
//       landfallDate: string (optional, up to 30)
//       evacuationCentres: list of strings (1 to 20)
//       puroks: list of strings (up to 50)
//       barangays: list of strings (up to 20)
//       hotline: string (up to 40)
//       otherFigures: list of numbers (up to 30)
//       bulletinText: string (up to 20000)
//     Rules can't loop over list items, so items are limited in number only;
//     Firestore's 1 MiB document limit bounds the rest. Only officers write.
//   - source: string, one of on_device, in_cloud, none, unknown
//   - edited: bool
//   - approvedBy: string, the signed-in officer's user ID
//   - approvedAt: timestamp, the server's time of the write
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOfficer() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/officers/$(request.auth.uid));
    }

    function isString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isList(value, minSize, maxSize) {
      return value is list && value.size() >= minSize && value.size() <= maxSize;
    }

    // ---------- Validators ----------

    function isValidFactSheet(sheet) {
      let required = ['stormName', 'signals', 'landfallTime', 'evacuationCentres', 'puroks',
                      'barangays', 'hotline', 'otherFigures', 'bulletinText'];
      return sheet is map
        && sheet.keys().hasAll(required)
        && sheet.keys().hasOnly(required.concat(['landfallDate']))
        && isString(sheet.stormName, 0, 100)
        && isList(sheet.signals, 1, 30)
        && sheet.landfallTime is string
        && sheet.landfallTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (!('landfallDate' in sheet) || isString(sheet.landfallDate, 1, 30))
        && isList(sheet.evacuationCentres, 1, 20)
        && isList(sheet.puroks, 0, 50)
        && isList(sheet.barangays, 0, 20)
        && isString(sheet.hotline, 0, 40)
        && isList(sheet.otherFigures, 0, 30)
        && isString(sheet.bulletinText, 0, 20000);
    }

    function isValidAlert(alertId, data) {
      let fields = ['household', 'area', 'areaKey', 'signal', 'text', 'factSheet', 'source',
                    'edited', 'approvedBy', 'approvedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.household in ['general', 'seniors', 'families', 'fishers']
        && isString(data.area, 1, 80)
        && isString(data.areaKey, 1, 80)
        && data.areaKey.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        // The ID names the household and area, so each has one current alert.
        && alertId == data.household + '__' + data.areaKey
        && data.signal is int
        && data.signal >= 1 && data.signal <= 5
        && isString(data.text, 1, 1000)
        && data.source in ['on_device', 'in_cloud', 'none', 'unknown']
        && data.edited is bool
        // Who approved it and when can't be made up by the client.
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time
        && isValidFactSheet(data.factSheet)
        // The area and its signal come from the fact sheet saved with the alert.
        && {'area': data.area, 'signal': data.signal} in data.factSheet.signals;
    }

    // ---------- Collections ----------

    // The officer list: each user may read only their own entry, to learn
    // whether they're an officer. Nobody writes it from the app.
    match /officers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Approved alerts. Saving a new approval replaces the old one (update).
    // No deletes from the app.
    match /alerts/{alertId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer() && isValidAlert(alertId, request.resource.data);
      allow delete: if false;
    }
  }
}
