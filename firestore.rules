rules_version = '2';

// ===============================================================
// Babala Firestore rules
// ===============================================================
//
// Only officers save alerts. An officer is someone signed in with Google
// whose user ID has a document in `officers`. The project owner adds those
// documents in the Firebase console, which these rules don't apply to; the
// app can't write them. Everything not allowed below is denied.
//
// Every change to a saved alert (an approval or a withdrawal) has a ledger
// entry, written in the same batch: the rules refuse the change without its
// entry and an entry without its change. Entries can't be changed or deleted,
// so the ledger keeps every approval and withdrawal.
//
// Residents (anonymous sign-in) read only `residentAlerts`: a copy of each
// alert without the officers' user IDs or the bulletin, written in the same
// batch as every approval and withdrawal and always equal to residentCopy() of
// its alert. A withdrawn alert's copy has no text. Residents never read
// `alerts` or the ledger.
//
// Officers publish Filipino and Cebuano translations on the copy of a current
// alert, one language at a time, each with a `translated` ledger entry in the
// same batch that names the alert's text and approval. A new approval or a
// withdrawal rewrites the copy without them.
//
// ===============================================================
// Data model
// ===============================================================
//
// Collection: officers
// Document ID: the officer's Firebase Auth user ID
// Fields: any (e.g. name: string), set by hand in the Firebase console.
//   Only the document's existence matters.
//
// Collection: alerts
// Document ID: "{household}__{areaKey}", e.g. "general__purok-ilaya".
//   One current alert per household type and area; a new approval replaces it.
//   Written by src/alerts/record.ts and src/alerts/store.ts. Keep the limits
//   here the same as LIMITS in record.ts.
// Fields (all required unless marked optional):
//   - household: string, one of general, seniors, families, fishers
//   - area: string, 1 to 80 characters, e.g. "Purok Ilaya"
//   - areaKey: string, 1 to 80 characters of a-z, 0-9 and single dashes
//   - signal: int, 1 to 5, the area's signal in the fact sheet
//   - text: string, 1 to 1000 characters, the alert as the checker passed it
//   - factSheet: map, the confirmed fact sheet:
//       stormName: string (up to 100)
//       signals: list of {area: string, signal: int} (1 to 30)
//       landfallTime: string "HH:MM", 24-hour
//       landfallDate: string (optional, up to 30)
//       evacuationCentres: list of strings (1 to 20)
//       puroks: list of strings (up to 50)
//       barangays: list of strings (up to 20)
//       hotline: string (up to 40)
//       otherFigures: list of numbers (up to 30)
//       bulletinText: string (up to 20000)
//     Rules can't loop over list items, so items are limited in number only;
//     Firestore's 1 MiB document limit bounds the rest. Only officers write.
//   - source: string, one of on_device, in_cloud, none, unknown
//   - edited: bool
//   - approvedBy: string, the signed-in officer's user ID
//   - approvedAt: timestamp, the server's time of the write
//   - ledgerId: string, the 20-character ID of the ledger entry written in
//     the same batch, which must record this alert exactly
//   - withdrawal: map (optional), added when an officer withdraws the alert;
//     nothing else may change then. A new approval replaces the whole alert,
//     which clears it.
//       ledgerId: string, the withdrawal's ledger entry, written in the same batch
//       by: string, the signed-in officer's user ID
//       at: timestamp, the server's time of the write
//
// Collection: residentAlerts
// Document ID: the alert's ID, "{household}__{areaKey}".
//   What residents read. Written by src/alerts/residentCopy.ts and
//   src/alerts/store.ts, and always equal to residentCopy() of the alert with
//   the same ID, after the batch that writes it.
// Fields while the alert is current (status "active"):
//   - household, area, areaKey, signal, text: the alert's
//   - stormName: the alert's factSheet.stormName
//   - status: "active"
//   - updatedAt: timestamp, the alert's approvedAt
//   - translations: map (optional), added after the approval, one language
//     per write, nothing else changing:
//       fil, ceb (each optional): {text: string (1 to 1500), ledgerId: string,
//         the `translated` ledger entry written in the same batch}
// Fields once the alert is withdrawn (status "withdrawn"), with no text:
//   - household, area, areaKey: the alert's
//   - status: "withdrawn"
//   - updatedAt: timestamp, the alert's withdrawal.at
//
// Collection: ledger
// Document ID: a 20-character auto ID made by the app.
//   One entry per change to a saved alert: "approved", "withdrawn" or
//   "translated".
//   Written by src/ledger/record.ts and src/alerts/store.ts. Keep the limits
//   here the same as LEDGER_LIMITS in src/ledger/record.ts.
// Fields of an "approved" entry (all required):
//   - kind: "approved"
//   - alertId: string, the alert this approval saved
//   - household, area, areaKey, signal, text, factSheet, source, edited:
//     equal to the alert's, which the alert's rules check
//   - cloudModel: string, up to 100 characters
//   - claimWords: list of strings (1 to 500), the checker's word list
//   - drafts: list of maps (up to 20), the model calls behind the approval
//   - draftsOmitted: int, 0 or more, older drafts left out
//   - by: string, the signed-in officer's user ID
//   - at: timestamp, the server's time of the write
// Fields of a "withdrawn" entry (all required):
//   - kind: "withdrawn"
//   - alertId: string, the alert withdrawn
//   - household, area, text: equal to the alert's
//   - approvalId: string, the alert's ledgerId before the withdrawal, or
//     empty for an alert saved before the ledger
//   - reason: string, 1 to 300 characters. Only here, never on the alert:
//     residents will read alerts, and the reason never passes the checker.
//   - by: string, the signed-in officer's user ID
//   - at: timestamp, the server's time of the write
// Fields of a "translated" entry (all required), written by
//   src/translation/record.ts and src/translation/store.ts:
//   - kind: "translated"
//   - alertId: string, the alert translated
//   - household, area: equal to the alert's
//   - lang: "fil" or "ceb"
//   - approvalId: string, the alert's ledgerId: the approval it translates
//   - english: string (1 to 1000), equal to the alert's text
//   - text: string (1 to 1500), equal to the translation on the resident copy
//   - source: string, one of in_cloud, none, unknown
//   - edited: bool
//   - cloudModel: string, up to 100 characters
//   - claimWords: list of strings (1 to 500), rule 5's English word list
//   - translatedClaims: list of maps (1 to 100), this language's claim words
//   - drafts: list of maps (up to 20), the cloud calls behind it
//   - draftsOmitted: int, 0 or more
//   - by: string, the signed-in officer's user ID
//   - at: timestamp, the server's time of the write
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOfficer() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/officers/$(request.auth.uid));
    }

    function isString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isList(value, minSize, maxSize) {
      return value is list && value.size() >= minSize && value.size() <= maxSize;
    }

    // ---------- Validators ----------

    function isValidFactSheet(sheet) {
      let required = ['stormName', 'signals', 'landfallTime', 'evacuationCentres', 'puroks',
                      'barangays', 'hotline', 'otherFigures', 'bulletinText'];
      return sheet is map
        && sheet.keys().hasAll(required)
        && sheet.keys().hasOnly(required.concat(['landfallDate']))
        && isString(sheet.stormName, 0, 100)
        && isList(sheet.signals, 1, 30)
        && sheet.landfallTime is string
        && sheet.landfallTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (!('landfallDate' in sheet) || isString(sheet.landfallDate, 1, 30))
        && isList(sheet.evacuationCentres, 1, 20)
        && isList(sheet.puroks, 0, 50)
        && isList(sheet.barangays, 0, 20)
        && isString(sheet.hotline, 0, 40)
        && isList(sheet.otherFigures, 0, 30)
        && isString(sheet.bulletinText, 0, 20000);
    }

    function isValidAlert(alertId, data) {
      let fields = ['household', 'area', 'areaKey', 'signal', 'text', 'factSheet', 'source',
                    'edited', 'approvedBy', 'approvedAt', 'ledgerId'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.household in ['general', 'seniors', 'families', 'fishers']
        && isString(data.area, 1, 80)
        && isString(data.areaKey, 1, 80)
        && data.areaKey.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        // The ID names the household and area, so each has one current alert.
        && alertId == data.household + '__' + data.areaKey
        && data.signal is int
        && data.signal >= 1 && data.signal <= 5
        && isString(data.text, 1, 1000)
        && data.source in ['on_device', 'in_cloud', 'none', 'unknown']
        && data.edited is bool
        // Who approved it and when can't be made up by the client.
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time
        && isLedgerId(data.ledgerId)
        && isValidFactSheet(data.factSheet)
        // The area and its signal come from the fact sheet saved with the alert.
        && {'area': data.area, 'signal': data.signal} in data.factSheet.signals
        && recordsThisAlert(alertId, data)
        && residentsGetThisAlert(alertId, data);
    }

    // The alert's ledger entry, as it will be after this batch, records exactly
    // this alert. Its time is this request's, so it is a new entry written in
    // the same batch, never an old one (entries can't be changed).
    function recordsThisAlert(alertId, data) {
      let entry = getAfter(/databases/$(database)/documents/ledger/$(data.ledgerId)).data;
      return entry.kind == 'approved'
        && entry.alertId == alertId
        && entry.household == data.household
        && entry.area == data.area
        && entry.areaKey == data.areaKey
        && entry.signal == data.signal
        && entry.text == data.text
        && entry.factSheet == data.factSheet
        && entry.source == data.source
        && entry.edited == data.edited
        && entry.by == data.approvedBy
        && entry.at == data.approvedAt;
    }

    function isLedgerId(value) {
      return value is string && value.matches('^[A-Za-z0-9]{20}$');
    }

    // An approval's entry. Its alert fields are checked through the alert,
    // which must be written in the same batch and point at this entry.
    function isValidApprovedEntry(entryId, data) {
      let fields = ['kind', 'alertId', 'household', 'area', 'areaKey', 'signal', 'text',
                    'factSheet', 'source', 'edited', 'cloudModel', 'claimWords', 'drafts',
                    'draftsOmitted', 'by', 'at'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.kind == 'approved'
        && isString(data.alertId, 4, 200)
        && data.alertId.matches('^[a-z]+__[a-z0-9]+(-[a-z0-9]+)*$')
        && isString(data.cloudModel, 0, 100)
        && isList(data.claimWords, 1, 500)
        && isList(data.drafts, 0, 20)
        && data.draftsOmitted is int
        && data.draftsOmitted >= 0
        && data.by == request.auth.uid
        && data.at == request.time
        && isWrittenWithItsAlert(entryId, data.alertId);
    }

    // The alert is saved in this same batch (its approval time is this
    // request's) and points at this entry.
    function isWrittenWithItsAlert(entryId, alertId) {
      let alert = getAfter(/databases/$(database)/documents/alerts/$(alertId)).data;
      return alert.ledgerId == entryId && alert.approvedAt == request.time;
    }

    // Withdrawing adds the withdrawal field to a saved alert that has none,
    // and changes nothing else.
    function isValidWithdrawal(alertId) {
      let before = resource.data;
      let after = request.resource.data;
      let w = after.withdrawal;
      return !('withdrawal' in before)
        && after.diff(before).affectedKeys().hasOnly(['withdrawal'])
        && w is map
        && w.keys().hasAll(['ledgerId', 'by', 'at'])
        && w.keys().hasOnly(['ledgerId', 'by', 'at'])
        && isLedgerId(w.ledgerId)
        && w.by == request.auth.uid
        && w.at == request.time
        && recordsThisWithdrawal(alertId, before, w)
        && residentsGetThisAlert(alertId, after);
    }

    // The withdrawal's ledger entry, as it will be after this batch, records
    // exactly this alert and the approval it withdraws. Its time is this
    // request's, so it is a new entry written in the same batch.
    function recordsThisWithdrawal(alertId, before, w) {
      let entry = getAfter(/databases/$(database)/documents/ledger/$(w.ledgerId)).data;
      return entry.kind == 'withdrawn'
        && entry.alertId == alertId
        && entry.household == before.household
        && entry.area == before.area
        && entry.text == before.text
        && entry.approvalId == before.get('ledgerId', '')
        && entry.by == w.by
        && entry.at == w.at;
    }

    // A withdrawal's entry. Its alert fields are checked through the alert,
    // whose withdrawal must be written in the same batch and point at it.
    function isValidWithdrawnEntry(entryId, data) {
      let fields = ['kind', 'alertId', 'household', 'area', 'text', 'approvalId', 'reason', 'by', 'at'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.kind == 'withdrawn'
        && isString(data.alertId, 4, 200)
        && data.alertId.matches('^[a-z]+__[a-z0-9]+(-[a-z0-9]+)*$')
        && (data.approvalId == '' || isLedgerId(data.approvalId))
        && isString(data.reason, 1, 300)
        && data.by == request.auth.uid
        && data.at == request.time
        && isWithdrawnWithItsAlert(entryId, data.alertId);
    }

    function isWithdrawnWithItsAlert(entryId, alertId) {
      let alert = getAfter(/databases/$(database)/documents/alerts/$(alertId)).data;
      return alert.withdrawal.ledgerId == entryId && alert.withdrawal.at == request.time;
    }

    // The copy residents read of this alert: its text and where it applies
    // while current, and only that it was withdrawn, and when, once withdrawn.
    // Never who approved or withdrew it, and never the bulletin.
    function residentCopy(alert) {
      return 'withdrawal' in alert
        ? {'household': alert.household, 'area': alert.area, 'areaKey': alert.areaKey,
           'status': 'withdrawn', 'updatedAt': alert.withdrawal.at}
        : {'household': alert.household, 'area': alert.area, 'areaKey': alert.areaKey,
           'signal': alert.signal, 'stormName': alert.factSheet.stormName, 'text': alert.text,
           'status': 'active', 'updatedAt': alert.approvedAt};
    }

    // The resident copy, as it will be after this batch, matches the alert as
    // it will be after this batch. Required with every approval and withdrawal,
    // so residents never keep an alert that was replaced or withdrawn.
    function residentsGetThisAlert(alertId, alert) {
      return getAfter(/databases/$(database)/documents/residentAlerts/$(alertId)).data
        == residentCopy(alert);
    }

    // A resident copy may only ever equal residentCopy() of its alert after
    // the batch. Written alone, that makes a copy of an alert saved before
    // copies existed, and can't say anything the alert doesn't.
    function isValidResidentCopy(alertId, data) {
      let alert = getAfter(/databases/$(database)/documents/alerts/$(alertId));
      return alert != null && data == residentCopy(alert.data);
    }

    // Publishing a translation changes only `translations` on an active copy,
    // and only one language. Each language that changes must be vouched for by
    // its new ledger entry.
    function isValidTranslationPublish(alertId) {
      let before = resource.data;
      let after = request.resource.data;
      let t = after.translations;
      let changed = t.diff(before.get('translations', {})).affectedKeys();
      return before.status == 'active'
        && after.diff(before).affectedKeys().hasOnly(['translations'])
        && t is map
        && t.keys().hasOnly(['fil', 'ceb'])
        && changed.size() == 1
        && (!changed.hasAny(['fil']) || publishesTranslation(alertId, 'fil', t.fil))
        && (!changed.hasAny(['ceb']) || publishesTranslation(alertId, 'ceb', t.ceb));
    }

    // The translation's ledger entry, as it will be after this batch, records
    // this text in this language, by this officer at this request's time (so
    // it is new, written in the same batch), against the alert's current text
    // and approval. The alert must not be withdrawn.
    function publishesTranslation(alertId, lang, t) {
      let alert = get(/databases/$(database)/documents/alerts/$(alertId)).data;
      let entry = getAfter(/databases/$(database)/documents/ledger/$(t.ledgerId)).data;
      return t is map
        && t.keys().hasAll(['text', 'ledgerId'])
        && t.keys().hasOnly(['text', 'ledgerId'])
        && isString(t.text, 1, 1500)
        && isLedgerId(t.ledgerId)
        && !('withdrawal' in alert)
        && entry.kind == 'translated'
        && entry.alertId == alertId
        && entry.lang == lang
        && entry.text == t.text
        && entry.household == alert.household
        && entry.area == alert.area
        && entry.approvalId == alert.ledgerId
        && entry.english == alert.text
        && entry.by == request.auth.uid
        && entry.at == request.time;
    }

    // A copy rewritten on its own, with no change to its alert in the batch,
    // can't drop published translations: only a new approval or a withdrawal,
    // each with its own ledger entry, clears them.
    function dropsTranslationsUnrecorded(alertId) {
      let alert = getAfter(/databases/$(database)/documents/alerts/$(alertId)).data;
      return 'translations' in resource.data
        && alert.approvedAt != request.time
        && !('withdrawal' in alert && alert.withdrawal.at == request.time);
    }

    // A translation's entry. Its alert fields are checked through the copy,
    // whose translation in this language must be written in the same batch
    // and point at this entry.
    function isValidTranslatedEntry(entryId, data) {
      let fields = ['kind', 'alertId', 'household', 'area', 'lang', 'approvalId', 'english', 'text',
                    'source', 'edited', 'cloudModel', 'claimWords', 'translatedClaims', 'drafts',
                    'draftsOmitted', 'by', 'at'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.kind == 'translated'
        && isString(data.alertId, 4, 200)
        && data.alertId.matches('^[a-z]+__[a-z0-9]+(-[a-z0-9]+)*$')
        && data.lang in ['fil', 'ceb']
        && isLedgerId(data.approvalId)
        && isString(data.english, 1, 1000)
        && isString(data.text, 1, 1500)
        && data.source in ['in_cloud', 'none', 'unknown']
        && data.edited is bool
        && isString(data.cloudModel, 0, 100)
        && isList(data.claimWords, 1, 500)
        && isList(data.translatedClaims, 1, 100)
        && isList(data.drafts, 0, 20)
        && data.draftsOmitted is int
        && data.draftsOmitted >= 0
        && data.by == request.auth.uid
        && data.at == request.time
        && isPublishedWithItsTranslation(entryId, data);
    }

    function isPublishedWithItsTranslation(entryId, data) {
      let copy = getAfter(/databases/$(database)/documents/residentAlerts/$(data.alertId)).data;
      return copy.translations[data.lang].ledgerId == entryId;
    }

    // ---------- Collections ----------

    // The officer list: each user may read only their own entry, to learn
    // whether they're an officer. Nobody writes it from the app.
    match /officers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Approved alerts. Saving a new approval replaces the old one (update),
    // and withdrawing marks it withdrawn (update), each together with a new
    // ledger entry. No deletes from the app.
    match /alerts/{alertId} {
      allow read: if isOfficer();
      allow create: if isOfficer() && isValidAlert(alertId, request.resource.data);
      allow update: if isOfficer()
        && (isValidAlert(alertId, request.resource.data) || isValidWithdrawal(alertId));
      allow delete: if false;
    }

    // What residents read: anyone signed in, anonymous residents included.
    // A list must ask for at most 200 documents, the whole barangay's pack
    // (4 households for each of up to 30 areas), so one read can't run up the
    // free quota. Only officers write: an exact copy of the alert, or one
    // checked translation added to the copy of a current alert.
    match /residentAlerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 200;
      allow create: if isOfficer() && isValidResidentCopy(alertId, request.resource.data);
      allow update: if isOfficer()
        && ((isValidResidentCopy(alertId, request.resource.data) && !dropsTranslationsUnrecorded(alertId))
            || isValidTranslationPublish(alertId));
      allow delete: if false;
    }

    // The ledger: written only together with the change it records (to the
    // alert, or a translation on its copy), and never changed or deleted.
    // Officers only.
    match /ledger/{entryId} {
      allow read: if isOfficer();
      allow create: if isOfficer()
        && (isValidApprovedEntry(entryId, request.resource.data)
            || isValidWithdrawnEntry(entryId, request.resource.data)
            || isValidTranslatedEntry(entryId, request.resource.data));
      allow update, delete: if false;
    }
  }
}
