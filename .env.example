# Copy to .env.local (gitignored) and fill in from the Firebase console.
# Never commit .env.local. Hosting builds read these from GitHub secrets.

# Firebase web app config (Project settings > Your apps > Babala web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for local work only (register it in the Firebase console)
VITE_APPCHECK_DEBUG_TOKEN=
