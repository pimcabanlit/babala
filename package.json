{
  "name": "babala",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:rules": "npx -y firebase-tools@15.36.0 emulators:exec --only firestore --project demo-babala \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx -y firebase-tools@15.36.0 emulators:start --only auth,firestore --project demo-babala",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
